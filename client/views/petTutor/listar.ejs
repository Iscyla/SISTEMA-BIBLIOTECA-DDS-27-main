
<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

    <h1 class="text-center">
        ESTOU NA PÁGINA DE PET's & TUTOR
    </h1>

    <!-- BOTÃO PARA PÁGINA DE CADASTRO -->
    <a href="/petTutor/cadastrar">
        <button class="btn-solid theme-accent"> + Cadastro </button>
    </a>

    <!-- TABELA COM OS DADOS DOS LIVROS -->
    <table class="table mt-5 table-bordered border-danger theme-danger fg-primary">

        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nome do Tutor</th>
                <th scope="col">CPF</th>
                <th scope="col">Telefone</th>
                <th scope="col">E-mail</th>
                <th scope="col">Nome do Pet</th>
                <th scope="col">Gênero</th>
            </tr>
        </thead>

        <tbody>

            <!-- LAÇO DE REPETIÇÃO PARA INTERAGIR COM A LISTA VINDO DO BACKEND -->
            <% listarPet.forEach( user => { %>

                <tr>

                    <td><%= user.id_tutor %></td>
                    <td><%= user.nome %></td>
                    <td><%= user.cpf %></td>
                    <td><%= user.telefone %></td>
                    <td><%= user.email %></td>
                    <td><%= user.nome_pet %></td>
                    <td><%= user.genero_pet %></td>

                    <!-- BOTÕES DE AÇÕES -->
                    <td class="d-flex justify-content-center gap-3">

                        <!-- BOTÃO DE EDITAR -->
                        <a href="/petTutor/editar/<%= user.id_tutor %>">
                            <button class="btn-solid theme-warning">
                                Editar
                            </button>
                        </a>

                        <!-- BOTÃO DE EXCLUIR -->
                        <form
                            action="/petTutor/deletar/<%= user.id_tutor %>"
                            method="post"
                            onsubmit="return confirm('Deseja realmente excluir esse cadastro?')"
                        >
                            <button type="submit" class="btn-solid theme-danger">
                                Excluir
                            </button>
                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
