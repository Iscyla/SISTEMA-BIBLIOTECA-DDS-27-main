<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">
  <h1 class="fg-accent fs-6x1">ESTOU NA PÁGINA DE CADASTRAR PET & TUTOR</h1>

  <!-- CRIAR O FORMULÁRIO DE CADASTRO -->
  <div class="d-flex flex-column">
    <!-- action - Fala a rota que o botão vai enviar as informações -->
    <form action="/petTutor/cadastrar" method="post">
      <!-- CAIXINHA DE TÍTULO -->
      <div class="form-group">
        <label for="nome_pet">Nome:</label>
        <input
          type="name"
          name="nome"
          id="nome"
          class="form-control"
          required
        />
      </div>

      <div class="form-group">
        <label for="cpf">CPF:</label>
        <input
          type="number"
          name="cpf"
          id="cpf"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE EMAIL -->
      <div class="form-group">
        <label for="telefone"> Telefone: </label>
        <input
          type="number"
          name="telefone"
          id="telefone"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE EMAIL -->
      <div class="form-group">
        <label for="email"> E-mail: </label>
        <input
          type="text"
          name="email"
          id="email"
          class="form-control"
          required
        />
      </div>

      <div class="form-group">
        <label for="nome_pet"> Nome Pet: </label>
        <input
          type="text"
          name="nome_pet"
          id="nome_pet"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE GENERO -->
      <div class="form-group">
        <label for="genero_pet"> Gênero: </label>
        <select name="genero_pet" id="genero_pet" class="form-control">
          <option value="femea">Fêmea</option>
          <option value="macho">Macho</option>
        </select>
      </div>

      <!-- BOTÃO DE ENVIO -->
      <button type="submit" class="btn-subtle theme-success mt-3">
        Cadastrar
      </button>
    </form>
  </div>
</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
