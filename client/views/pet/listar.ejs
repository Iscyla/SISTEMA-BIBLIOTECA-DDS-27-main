
<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

    <h1 class="text-center">
        ESTOU NA PÁGINA DE PET's
    </h1>

    <!-- BOTÃO PARA PÁGINA DE CADASTRO -->
    <a href="/pet/cadastrar">
        <button class="btn-solid theme-accent"> + Pet </button>
    </a>

    <!-- TABELA COM OS DADOS DOS LIVROS -->
    <table class="table mt-5 table-bordered border-danger theme-danger fg-primary">

        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nome do Pet</th>
                <th scope="col">Tutor</th>
                <th scope="col">Gênero</th>
            </tr>
        </thead>

        <tbody>

            <!-- LAÇO DE REPETIÇÃO PARA INTERAGIR COM A LISTA VINDO DO BACKEND -->
            <% listarPet.forEach( user => { %>

                <tr>

                    <td><%= pet.id_pet %></td>
                    <td><%= pet.nome_pet %></td>
                    <td><%= pet.tutor %></td>
                    <td><%= livro.genero %></td>

                    <!-- BOTÕES DE AÇÕES -->
                    <td class="d-flex justify-content-center gap-3">

                        <!-- BOTÃO DE EDITAR -->
                        <a href="/pet/editar/<%= user.id_pet %>">
                            <button class="btn-solid theme-warning">
                                Editar
                            </button>
                        </a>

                        <!-- BOTÃO DE EXCLUIR -->
                        <form
                            action="/pet/deletar/<%= user.id_pet %>"
                            method="post"
                            onsubmit="return confirm('Deseja realmente excluir esse pet?')"
                        >
                            <button type="submit" class="btn-solid theme-danger">
                                Excluir
                            </button>
                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
