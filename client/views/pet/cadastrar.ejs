<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">
  <h1 class="fg-accent fs-6x1">ESTOU NA PÁGINA DE CADASTRAR PET</h1>

  <!-- CRIAR O FORMULÁRIO DE CADASTRO -->
  <div class="d-flex flex-column">
    <!-- action - Fala a rota que o botão vai enviar as informações -->
    <form action="/pet/cadastrar" method="post">
      <!-- CAIXINHA DE TÍTULO -->
      <div class="form-group">
        <label for="nome_pet">Nome:</label>
        <input
          type="name"
          name="nome"
          id="nome"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE EMAIL -->
      <div class="form-group">
        <label for="tutor"> Tutor: </label>
        <input
          type="text"
          name="tutor"
          id="tutor"
          class="form-control"
          required
        />
      </div>


      <!-- CAIXINHA DE GENERO -->
      <div class="form-group">
        <label for="genero"> Genêro: </label>
        <select name="genero" id="genero" class="form-control">
          <option value="femea">Fêmea</option>
          <option value="Macho">Macho</option>
        </select>
      </div>

      <!-- BOTÃO DE ENVIO -->
      <button type="submit" class="btn-subtle theme-success mt-3">
        Cadastrar
      </button>
    </form>
  </div>
</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
