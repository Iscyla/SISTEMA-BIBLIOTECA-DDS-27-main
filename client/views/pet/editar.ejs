
<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

  <h1 class="fg-accent fs-6x1">
    ESTOU NA PÁGINA DE EDIÇÃO
  </h1>

  <!-- FORMULÁRIO DE EDIÇÃO -->
  <div class="d-flex flex-column">

    <form
    action="/livros/editar/<%= livroEditado.id_livro %>"
    method="post"
    >

      <!-- CAMPO TÍTULO -->
      <div class="form-group">
        <label for="titulo">Título:</label>

        <input
          type="text"
          name="titulo"
          id="titulo"
          class="form-control"
          required
          value="<%= livroEditado.titulo %>"
        />
      </div>

      <!-- CAMPO AUTOR -->
      <div class="form-group">
        <label for="autor">Autor:</label>

        <input
          type="text"
          name="autor"
          id="autor"
          class="form-control"
          required
          value="<%= livroEditado.autor %>"
        />
      </div>

      <!-- CAMPO ANO DE PUBLICAÇÃO -->
      <div class="form-group">
        <label for="ano_publicacao">
          Data de publicação:
        </label>

        <input
          type="date"
          name="ano_publicacao"
          id="ano_publicacao"
          class="form-control"
          required
          value="<%= livroEditado.ano_publicacao ? new Date(livroEditado.ano_publicacao).toISOString().split('T')[0] : '' %>"
        />
      </div>

      <!-- CAMPO GÊNERO -->
      <div class="form-group">
        <label for="genero">Gênero:</label>

        <select
          name="genero"
          id="genero"
          class="form-control"
          required
        >
          <option value="romance" <%= livroEditado.genero === "romance" ? "selected" : "" %>>
            Romance
          </option>

          <option value="distopia" <%= livroEditado.genero === "distopia" ? "selected" : "" %>>
            Distopia
          </option>

          <option value="aventura" <%= livroEditado.genero === "aventura" ? "selected" : "" %>>
            Aventura
          </option>
        </select>
      </div>

      <!-- CAMPO DISPONIBILIDADE -->
      <div class="form-group">
        <label for="esta_disponivel">
          Está disponível?
        </label>

        <select
          name="esta_disponivel"
          id="esta_disponivel"
          class="form-control"
          required
        >
          <option value="sim" <%= livroEditado.esta_disponivel === "sim" ? "selected" : "" %>>
            Sim
          </option>

          <option value="nao" <%= livroEditado.esta_disponivel === "nao" ? "selected" : "" %>>
            Não
          </option>
        </select>
      </div>

      <!-- BOTÃO DE ENVIO -->
      <button
        type="submit"
        class="btn-subtle theme-success mt-3"
      >
        Confirmar edição
      </button>

    </form>

  </div>

</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
