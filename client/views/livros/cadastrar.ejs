<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">
  <h1 class="fg-accent fs-6x1">ESTOU NA PÁGINA DE CADASTRAR LIVROS</h1>

  <!-- CRIAR O FORMULÁRIO DE CADASTRO -->
  <div class="d-flex flex-column">
    <!-- action - Fala a rota que o botão vai enviar as informações -->
    <form action="/livros/cadastrar" method="post">

      <!-- CAIXINHA DE TÍTULO -->
      <div class="form-group">
        <label for="titulo">Título:</label>
        <input
          type="text"
          name="titulo"
          id="titulo"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE EMAIL -->
      <div class="form-group">
        <label for="autor"> Autor: </label>
        <input
          type="autor"
          name="autor"
          id="autor"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE SENHA -->
      <div class="form-group">
        <label for="ano_publicacao">Data de publicação:</label>
        <input
          type="date"
          name="ano_publicacao"
          id="ano_publicacao"
          class="form-control"
          required
        />
      </div>

      <!-- CAIXINHA DE GENERO -->
      <div class="form-group">
        <label for="genero"> Genêro: </label>
        <select name="genero" id="genero" class="form-control">
          <option value="romance">Romance</option>
          <option value="distopia">Distopia</option>
          <option value="aventura">Aventura</option>
        </select>
      </div>

      <!-- CAIXINHA DE DISPONIVEL -->
      <div class="form-group">
        <label for="esta_disponivel"> Disponível: </label>
        <select
          name="esta_disponivel"
          id="esta_disponivel"
          class="form-control"
        >
          <option value="sim">Sim</option>
          <option value="nao">Não</option>
        </select>
      </div>

      <!-- BOTÃO DE ENVIO -->
      <button type="submit" class="btn-subtle theme-success mt-3">
        Cadastrar
      </button>
    </form>
  </div>
</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
