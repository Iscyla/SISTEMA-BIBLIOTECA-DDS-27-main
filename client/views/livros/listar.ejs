
<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

    <h1 class="text-center">
        ESTOU NA PÁGINA DE LISTAR OS LIVROS
    </h1>

    <!-- BOTÃO PARA PÁGINA DE CADASTRO -->
    <a href="/livros/cadastrar">
        <button class="btn-solid theme-accent"> + Novo livro </button>
    </a>

    <!-- TABELA COM OS DADOS DOS LIVROS -->
    <table class="table mt-5 table-bordered border-danger theme-danger fg-primary">

        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Título</th>
                <th scope="col">Autor</th>
                <th scope="col">Ano de publicação</th>
                <th scope="col">Gênero</th>
                <th scope="col">Disponível</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>

        <tbody>

            <!-- LAÇO DE REPETIÇÃO PARA INTERAGIR COM A LISTA VINDO DO BACKEND -->
            <% listaLivros.forEach(livro => { %>

                <tr>

                    <td><%= livro.id_livro %></td>

                    <td><%= livro.titulo %></td>

                    <td><%= livro.autor %></td>

                    <td><%= new Date(livro.ano_publicacao).toLocaleDateString('pt-BR') %></td>

                    <td><%= livro.genero %></td>

                    <td><%= livro.esta_disponivel %></td>

                    <!-- BOTÕES DE AÇÕES -->
                    <td class="d-flex justify-content-center gap-3">

                        <!-- BOTÃO DE EDITAR -->
                        <a href="/livros/editar/<%= livro.id_livro %>">
                            <button class="btn-solid theme-warning">
                                Editar
                            </button>
                        </a>

                        <!-- BOTÃO DE EXCLUIR -->
                        <form
                            action="/livros/deletar/<%= livro.id_livro %>"
                            method="post"
                            onsubmit="return confirm('Deseja realmente excluir esse livro?')"
                        >
                            <button type="submit" class="btn-solid theme-danger">
                                Excluir
                            </button>
                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
