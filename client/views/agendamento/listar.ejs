
<!-- IMPORTAÇÃO DO HEADER -->
<%- include('../partials/header') %>

<main class="container my-2 flex-grow-1">

    <h1 class="text-center">
        ESTOU NA PÁGINA CONSULTAS AGENDADAS
    </h1>

    <!-- BOTÃO PARA PÁGINA DE CADASTRO -->
    <a href="/agendamento/cadastrar">
        <button class="btn-solid theme-accent"> + Cadastro </button>
    </a>

    <!-- TABELA COM OS DADOS DOS LIVROS -->
    <table class="table mt-5 table-bordered border-danger theme-danger fg-primary">

        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Data Agendamento</th>
                <th scope="col">Tutor</th>
            </tr>
        </thead>

        <tbody>

            <!-- LAÇO DE REPETIÇÃO PARA INTERAGIR COM A LISTA VINDO DO BACKEND -->
            <% listarPet.forEach( user => { %>

                <tr>

                    <td><%= user.id_agendamento %></td>
                    <td><%= user.dt_agendamento %></td>
                    <td><%= user.id_tutor %></td>

                    <!-- BOTÕES DE AÇÕES -->
                    <td class="d-flex justify-content-center gap-3">

                        <!-- BOTÃO DE EDITAR -->
                        <a href="/agendamento/editar/<%= user.id_agendamento %>">
                            <button class="btn-solid theme-warning">
                                Editar
                            </button>
                        </a>

                        <!-- BOTÃO DE EXCLUIR -->
                        <form
                            action="/agendamento/deletar/<%= user.id_agendamento %>"
                            method="post"
                            onsubmit="return confirm('Deseja realmente excluir esse cadastro?')"
                        >
                            <button type="submit" class="btn-solid theme-danger">
                                Excluir
                            </button>
                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</main>

<!-- IMPORTAÇÃO DO FOOTER -->
<%- include('../partials/footer') %>
